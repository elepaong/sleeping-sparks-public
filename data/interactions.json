    "trigger": "place",
    "effect": {
      "type": "set_state",
      "state": "bent_{side}"
    },
    "persistent": false,
    "fact_check": {
      "checked": true,
      "note": "전기를 띤 빗·호박을 가는 물줄기에 가까이 대면 물줄기가 그쪽으로 휘는 것은 널리 알려진 실험. 전기가 (+)든 (−)든 끌려온다. 까닭은 물 분자의 극성이 아니라, 수반과 이어진 물에 반대 전하가 유도되어 물줄기가 알짜 전하를 띠기 때문(Ziaei-Moayyed, Goodman, Williams, J. Chem. Educ. 77, 1520, 2000, doi:10.1021/ed077p1520). 휘는 정도는 몇 cm 수준이므로 깔때기는 물줄기 바로 옆에 둔다.",
      "checked_by": "2026-11-10 별도 서브에이전트(사실 확인 전담)"
    },
    "status": "reviewed"
  },
